generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  AUTHOR
  MEDICAL_EXPERT
  USER
}

enum ArticleStatus {
  DRAFT
  REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role       @default(USER)
  createdAt    DateTime   @default(now())
  articles     Article[]
  favorites    Favorite[]
  comments     Comment[]
  auditLogs    AuditLog[]
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  articles Article[]
  diseases Disease[]
}

model Tag {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  articles Article[]
}

model Article {
  id               String        @id @default(cuid())
  title            String
  shortDescription String        @db.Text
  content          String        @db.Text
  coverImage       String?
  slug             String        @unique
  seoTitle         String?
  seoDescription   String?
  status           ArticleStatus @default(DRAFT)
  publishedAt      DateTime?
  updatedAt        DateTime      @updatedAt
  createdAt        DateTime      @default(now())
  authorId         String
  author           User          @relation(fields: [authorId], references: [id])
  categoryId       String?
  category         Category?     @relation(fields: [categoryId], references: [id])
  tags             Tag[]
  medicalExpertId  String?
  sources          Json?
  views            Int           @default(0)
  comments         Comment[]
  favorites        Favorite[]
}

model Disease {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  summary         String    @db.Text
  symptoms        String    @db.Text
  causes          String    @db.Text
  riskFactors     String    @db.Text
  diagnosis       String    @db.Text
  treatment       String    @db.Text
  prevention      String    @db.Text
  whenToSeeDoctor String    @db.Text
  expertComment   String    @db.Text
  sources         Json?
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  reviewed        Boolean   @default(false)
  updatedAt       DateTime  @updatedAt
}

model Expert {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  photo       String?
  specialty   String
  experience  Int
  qualification String @db.Text
  workplace   String?
  bio         String  @db.Text
  verified    Boolean @default(false)
}

model Video {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  embedUrl    String
  thumbnail   String?
  publishedAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  body      String   @db.Text
  approved  Boolean  @default(false)
  articleId String
  article   Article  @relation(fields: [articleId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Favorite {
  id        String  @id @default(cuid())
  userId    String
  articleId String
  user      User    @relation(fields: [userId], references: [id])
  article   Article @relation(fields: [articleId], references: [id])

  @@unique([userId, articleId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model AdPlacement {
  id           String  @id @default(cuid())
  name         String
  location     String
  enabled      Boolean @default(true)
  content      String  @db.Text
  sponsorLabel Boolean @default(true)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())
}
